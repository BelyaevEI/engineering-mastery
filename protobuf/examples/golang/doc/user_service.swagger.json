{
  "swagger": "2.0",
  "info": {
    "title": "user_service.proto",
    "version": "version not set"
  },
  "tags": [
    {
      "name": "UserService"
    }
  ],
  "consumes": [
    "application/json"
  ],
  "produces": [
    "application/json"
  ],
  "paths": {
    "/api/v1/user": {
      "post": {
        "summary": "CreateUser - создание нового пользователя",
        "operationId": "UserService_CreateUser",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/userUser"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/userCreateUserRequest"
            }
          }
        ],
        "tags": [
          "UserService"
        ]
      }
    },
    "/api/v1/user/{user_id}": {
      "get": {
        "summary": "GetUser - получение данных о пользователе по его ID\nВозвращает ошибку NOT_FOUND если пользователь не существует",
        "operationId": "UserService_GetUser",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/userUser"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "user_id",
            "description": "Unique identifier of user",
            "in": "path",
            "required": true,
            "type": "string"
          },
          {
            "name": "field_mask",
            "description": "Маска полей для выборочного возврата\nПозволяет клиенту запрашивать только нужные поля",
            "in": "query",
            "required": false,
            "type": "string"
          }
        ],
        "tags": [
          "UserService"
        ]
      }
    }
  },
  "definitions": {
    "protobufAny": {
      "type": "object",
      "properties": {
        "@type": {
          "type": "string"
        }
      },
      "additionalProperties": {}
    },
    "rpcStatus": {
      "type": "object",
      "properties": {
        "code": {
          "type": "integer",
          "format": "int32"
        },
        "message": {
          "type": "string"
        },
        "details": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/protobufAny"
          }
        }
      }
    },
    "userCreateUserRequest": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "User ID in format user/{id}",
          "title": "Уникальный идентификатор пользователя в формате \"user/{id}\"\nExamples: \"user/123\", \"user/abc-123-def\"\nЕсли не указан, генерируется сервером"
        },
        "email": {
          "type": "string",
          "description": "User email address",
          "title": "Email пользователя (обязательный для создания)"
        },
        "age": {
          "type": "integer",
          "format": "int32",
          "description": "User age in years",
          "title": "Возраст пользователя в годах\nValid range: 0-150 (по статистике, живут не дольше ~122 лет)"
        },
        "metadata": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "description": "Additional metadata as key-value pairs",
          "title": "Дополнительные метаданные в формате key-value\nПолезно для хранения кастомных данных без изменения схемы"
        }
      },
      "title": "CreateUserRequest - запрос на создание пользователя\nID может быть передан клиентом или генерируется сервером",
      "required": [
        "email"
      ]
    },
    "userUser": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "title": "Уникальный идентификатор пользователя в формате \"user/{id}\"\nOutput only - генерируется сервером",
          "readOnly": true
        },
        "email": {
          "type": "string",
          "title": "Email пользователя (должен быть уникален)\nRequired: для аутентификации"
        },
        "age": {
          "type": "integer",
          "format": "int32",
          "title": "Возраст пользователя в годах\nValid range: 0-150 (согласно statistics, живут не дольше ~122 лет)"
        },
        "status": {
          "$ref": "#/definitions/userUserStatus",
          "title": "Статус пользователя",
          "readOnly": true
        },
        "created_at": {
          "type": "string",
          "format": "date-time",
          "title": "Дата создания записи",
          "readOnly": true
        },
        "updated_at": {
          "type": "string",
          "format": "date-time",
          "title": "Дата последнего обновления",
          "readOnly": true
        },
        "last_login_at": {
          "type": "string",
          "format": "date-time",
          "title": "Дата последнего входа",
          "readOnly": true
        },
        "metadata": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "title": "Дополнительные метаданные в формате key-value\nПолезно для хранения кастомных данных без изменения схемы"
        }
      },
      "title": "User - сущность пользователя\nСледует Google Cloud API Design Guidelines",
      "required": [
        "email"
      ]
    },
    "userUserStatus": {
      "type": "string",
      "enum": [
        "USER_STATUS_UNSPECIFIED",
        "ACTIVE",
        "BLOCKED",
        "PENDING_ACTIVATION",
        "DELETED"
      ],
      "default": "USER_STATUS_UNSPECIFIED",
      "description": "- USER_STATUS_UNSPECIFIED: Неизвестный статус (default)\n - ACTIVE: Активный пользователь - может использовать систему\n - BLOCKED: Заблокирован администратором (например, за нарушение правил)\n - PENDING_ACTIVATION: Ожидает подтверждения email (после регистрации)\n - DELETED: Удалён (soft delete - может быть восстановлен)",
      "title": "UserStatus - статус пользователя\nИспользуем camelCase для совместимости с JSON"
    }
  }
}
